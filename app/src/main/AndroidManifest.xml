<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="28" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera" android:required="false" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
        </intent>
    </queries>

    <!-- Enable hardware acceleration to prevent Binder transaction failures on Recents snapshot capture -->
    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/mainscclogo"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/mainscclogo"
        android:supportsRtl="true"
        android:theme="@style/Theme.CampusAlert"
        android:hardwareAccelerated="true"
        android:largeHeap="true">

        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="AIzaSyDKupevbEcyFITS2H0rvO_5mT8Bu5HF-Fc" />

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.unique.campus.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:hardwareAccelerated="true"
            android:screenOrientation="portrait"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".StudentDashboardActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".ReportSubmissionActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".ReportDetailActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".MaintenanceDashboardActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".AdminAnalyticsActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".SettingsActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".NotificationsActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />
        <activity android:name=".ReportListActivity" android:hardwareAccelerated="true" android:screenOrientation="portrait" />

        <service
            android:name=".MyFirebaseMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

    </application>

</manifest>
