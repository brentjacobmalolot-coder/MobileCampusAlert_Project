<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.CampusAlert" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/onPrimary</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/onSecondary</item>
        
        <!-- Radical fix for Transsion Dynamic Bar OpenGL swap errors -->
        <item name="android:windowLayoutInDisplayCutoutMode">never</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:windowIsFloating">false</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:windowContentOverlay">@null</item>

        <!-- Use opaque colors for system bars to prevent surface mismatches -->
        <item name="android:statusBarColor">@color/forest_green</item>
        <item name="android:navigationBarColor">#000000</item>
        
        <!-- Background/Surface colors. -->
        <item name="android:windowBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        
        <!-- Shape appearance -->
        <item name="shapeAppearanceLargeComponent">@style/ShapeAppearance.CampusAlert.Large</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.CampusAlert.Medium</item>
    </style>

    <style name="Theme.CampusAlert" parent="Base.Theme.CampusAlert" />

    <style name="ShapeAppearance.CampusAlert.Large" parent="ShapeAppearance.Material3.LargeComponent">
        <item name="cornerSize">16dp</item>
    </style>
    
    <style name="ShapeAppearance.CampusAlert.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">12dp</item>
    </style>
</resources>
