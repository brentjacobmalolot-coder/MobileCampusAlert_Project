<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="20dp"
    app:cardElevation="3dp"
    app:cardUseCompatPadding="true"
    app:strokeWidth="1dp"
    app:strokeColor="#EEEEEE"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- leading Status Icon Container -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/icon_container"
            android:layout_width="52dp"
            android:layout_height="52dp"
            app:cardCornerRadius="14dp"
            app:cardBackgroundColor="#F1F8E9"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">
            <ImageView
                android:id="@+id/status_icon"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_info_details"
                app:tint="@color/forest_green" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Information Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/priority_tag"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRIORITY"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/bg_priority_tag"
                android:layout_marginBottom="4dp" />

            <TextView
                android:id="@+id/report_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Report Title"
                android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
                android:textColor="@color/forest_green"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/report_building"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Location Details"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="@color/sage_green"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Trailing Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/status_pill"
            style="@style/Widget.Material3.Button.IconButton.Filled"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:insetLeft="0dp"
            android:insetTop="0dp"
            android:insetRight="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconSize="20dp"
            app:iconTint="@color/white"
            app:backgroundTint="@color/forest_green"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>